---------------------------------------------------------------------
-- UTILIDADES
---------------------------------------------------------------------
local function roleOf(plr)
	local ch = plr.Character
	if not ch then return "Innocent" end
	local bp = plr:FindFirstChild("Backpack")
	local function has(n)
		return ch:FindFirstChild(n) or (bp and bp:FindFirstChild(n))
	end
	if has("Knife") then return "Murderer" end
	if has("Revolver") or has("Gun") then return "Sheriff" end
	return "Innocent"
end

local function alive(plr)
	local ch = plr.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0
end

local function getMurderer()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and alive(p) and roleOf(p) == "Murderer" then return p end
	end
end

local function nearestOther()
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local best, bd
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and alive(p) then
			local h = p.Character and p.Character:FindFirstChild("Head")
			if h then
				local d = (h.Position - hrp.Position).Magnitude
				if not bd or d < bd then best, bd = p, d end
			end
		end
	end
	return best
end

local function getTool(...)
	local ch = LP.Character
	if not ch then return end
	for _, n in ipairs({...}) do
		local t = ch:FindFirstChild(n)
		if t then return t end
	end
	local bp = LP:FindFirstChild("Backpack")
	for _, n in ipairs({...}) do
		local t = bp and bp:FindFirstChild(n)
		if t then
			local hum = ch:FindFirstChildOfClass("Humanoid")
			if hum then hum:EquipTool(t) end
			return t
		end
	end
end

local function fireTool(tool, arg)
	if not tool then return end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("RemoteEvent") then
			if arg then pcall(d.FireServer, d, arg) else pcall(d.FireServer, d) end
		end
	end
	pcall(function() tool:Activate() end)
end

local function inFOV(pos)
	local sp, on = Cam:WorldToViewportPoint(pos)
	if not on or sp.Z <= 0 then return false end
	local c = Cam.ViewportSize
	return (Vector2.new(sp.X, sp.Y) - Vector2.new(c.X / 2, c.Y / 2)).Magnitude <= Cfg.FOV
end

local function face(pos)
	local ch = LP.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(pos.X, hrp.Position.Y, pos.Z))
	end
end

