local function toggle(parent, text, def, cb)
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, 26)
	row.BackgroundColor3 = Color3.fromRGB(26, 26, 33)
	row.Text = ""
	row.AutoButtonColor = false
	row.BorderSizePixel = 0
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -60, 1, 0)
	l.Position = UDim2.fromOffset(10, 0)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.Gotham
	l.TextSize = 12
	l.TextColor3 = Color3.fromRGB(215, 215, 225)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Text = text
	l.Parent = row
	local st = Instance.new("TextLabel")
	st.Size = UDim2.fromOffset(44, 18)
	st.Position = UDim2.new(1, -52, 0, 4)
	st.Font = Enum.Font.GothamBold
	st.TextSize = 11
	st.Parent = row
	Instance.new("UICorner", st).CornerRadius = UDim.new(0, 4)
	local on = def
	local function paint()
		st.Text = on and "ON" or "OFF"
		st.BackgroundColor3 = on and Color3.fromRGB(0, 170, 105) or Color3.fromRGB(40, 40, 48)
		st.TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(160, 160, 170)
	end
	paint()
	row.MouseButton1Click:Connect(function()
		on = not on
		paint()
		cb(on)
	end)
end

local function slider(parent, text, min, max, def, cb)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 36)
	row.BackgroundColor3 = Color3.fromRGB(26, 26, 33)
	row.BorderSizePixel = 0
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -60, 0, 18)
	l.Position = UDim2.fromOffset(10, 2)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.Gotham
	l.TextSize = 12
	l.TextColor3 = Color3.fromRGB(215, 215, 225)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Text = text
	l.Parent = row
	local v = Instance.new("TextLabel")
	v.Size = UDim2.fromOffset(44, 16)
	v.Position = UDim2.new(1, -54, 0, 3)
	v.BackgroundTransparency = 1
	v.Font = Enum.Font.GothamBold
	v.TextSize = 11
	v.TextColor3 = Color3.fromRGB(0, 220, 130)
	v.TextXAlignment = Enum.TextXAlignment.Right
	v.Text = tostring(def)
	v.Parent = row
	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -20, 0, 5)
	track.Position = UDim2.fromOffset(10, 25)
	track.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	track.BorderSizePixel = 0
	track.Parent = row
	Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(0, 200, 120)
	fill.BorderSizePixel = 0
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)
	local held = false
	local function set(px)
		local a = math.clamp((px - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local val = math.floor(min + (max - min) * a + 0.5)
		v.Text = tostring(val)
		fill.Size = UDim2.new(a, 0, 1, 0)
		cb(val)
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			held = true
			set(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if held and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			set(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			held = false
		end
	end)
end

