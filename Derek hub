-- ESP
---------------------------------------------------------------------
local espCache = {}
task.spawn(function()
	while task.wait(0.4) do
		if not Cfg.ESP then
			for _, h in pairs(espCache) do pcall(function() h:Destroy() end) end
			espCache = {}
		else
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LP and plr.Character and alive(plr) then
					local h = espCache[plr]
					if not h or not h.Parent then
						h = Instance.new("Highlight")
						h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						h.FillTransparency = 0.6
						h.OutlineTransparency = 0
						h.Parent = plr.Character
						espCache[plr] = h
					end
					h.Adornee = plr.Character
					local r = roleOf(plr)
					local col = Color3.fromRGB(60, 255, 120)
					if r == "Murderer" then
						col = Color3.fromRGB(255, 45, 45)
					elseif r == "Sheriff" then
						col = Color3.fromRGB(45, 145, 255)
					end
					h.FillColor = col
					h.OutlineColor = col
				end
			end
		end
	end
end)

---------------------------------------------------------------------
-- HITBOX
---------------------------------------------------------------------
local hbStore = {}
task.spawn(function()
	while task.wait(0.2) do
		if Cfg.Hitbox then
			local mur = getMurderer()
			if mur and mur.Character then
				local hrp = mur.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					if not hbStore[hrp] then hbStore[hrp] = hrp.Size end
					hrp.Size = Vector3.new(2, 2, 1) * Cfg.HitboxScale
					hrp.CanCollide = false
					hrp.CanQuery = true
				end
			end
		elseif next(hbStore) then
			for p, s in pairs(hbStore) do
				if p and p.Parent then p.Size = s end
			end
			hbStore = {}
		end
	end
end)

---------------------------------------------------------------------
-- AUTO FARM
---------------------------------------------------------------------
task.spawn(function()
	while task.wait(0.1) do
		if Cfg.AutoFarm then
			local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				for _, d in ipairs(WS:GetDescendants()) do
					if d:IsA("BasePart") and d.Name:lower():find("coin") then
						hrp.CFrame = CFrame.new(d.Position + Vector3.new(0, 2.5, 0))
						break
					end
				end
				task.wait(Cfg.FarmDelay / 1000)
			end
		end
	end
end)

---------------------------------------------------------------------
-- LOOP PRINCIPAL
---------------------------------------------------------------------
local lastFire, lastKill = 0, 0
RunService.RenderStepped:Connect(function()
	if circle then
		local c = Cam.ViewportSize
		circle.Position = Vector2.new(c.X / 2, c.Y / 2)
		circle.Radius = Cfg.FOV
		circle.Visible = Cfg.AutoShoot
	end

	-- Auto Shoot (solo si llevo arma)
	if Cfg.AutoShoot and roleOf(LP) == "Sheriff" then
		local mur = getMurderer()
		local head = mur and mur.Character and mur.Character:FindFirstChild("Head")
		if head and inFOV(head.Position) and tick() - lastFire >= Cfg.FireDelay / 1000 then
			lastFire = tick()
			if Cfg.AimAssist then face(head.Position) end
			fireTool(getTool("Revolver", "Gun"), head.Position)
		end
	end

	-- Opciones de asesino
	if Cfg.AutoKill and roleOf(LP) == "Murderer" then
		local t = nearestOther()
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		local head = t and t.Character and t.Character:FindFirstChild("Head")
		if hrp and head and (head.Position - hrp.Position).Magnitude <= Cfg.KillRange and tick() - lastKill >= 0.3 then
			lastKill = tick()
			face(head.Position)
			fireTool(getTool("Knife"))
		end
	end
end)

